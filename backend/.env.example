# Copy this to backend/.env and fill values before running the app.
# Local PostgreSQL example:
DATABASE_URL=postgresql://your-postgres-user@127.0.0.1:5432/dasher
# In deployment, set this same variable in the host's secret settings with the
# connection URL for your own PostgreSQL server or managed PostgreSQL service.

# Other env examples
# SECRET_KEY=your_django_secret_key
# GEMINI_API_KEY=
