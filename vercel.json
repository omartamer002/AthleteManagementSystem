{
  "version": 2,
  "builds": [
    {
      "src": "backend/ams_core/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.12"
      ,
        "installCommand": "pip install -r backend/requirements.txt",
        "buildCommand": "python backend/manage.py collectstatic --noinput"
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/ams_core/wsgi.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "backend/ams_core/wsgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
